{
  "schemaVersion": "1.0",
  "repository": "sdk",
  "componentVersion": "0.2.1",
  "governance": {
    "knowledgeCategory": "C",
    "evidenceLevel": "D",
    "approvalStatus": "Aprovado"
  },
  "targets": {
    "unitCoverage": 90,
    "integrationCoverage": 80,
    "criticalWorkflows": 100,
    "criticalSecurityControls": 100,
    "publicApiContracts": 100,
    "frameworkValidation": 100,
    "evidenceGeneration": 100
  },
  "categories": {
    "unit": {
      "status": "required",
      "command": "python -m unittest discover -s tests -v",
      "evidence": ["tests"]
    },
    "integration": {
      "status": "required",
      "command": "python -m unittest discover -s tests -v",
      "evidence": ["tests"]
    },
    "contract": {
      "status": "required",
      "command": "python -m unittest discover -s tests -v",
      "evidence": ["tests"]
    },
    "regression": {
      "status": "required",
      "command": "python -m unittest discover -s tests -v",
      "evidence": ["tests"]
    },
    "e2e": {
      "status": "not_applicable",
      "justification": "The SDK is a library and its system boundaries are exercised by downstream repositories."
    },
    "performance": {
      "status": "required",
      "command": "python tools/performance_baseline.py --output artifacts/performance-evidence.json",
      "evidence": ["tools/performance_baseline.py", ".github/workflows/ci.yml"]
    },
    "load": {
      "status": "not_applicable",
      "justification": "The SDK does not operate a concurrent network service."
    },
    "stress": {
      "status": "not_applicable",
      "justification": "Stress behavior belongs to deployed runtime consumers of the SDK."
    },
    "chaos": {
      "status": "not_applicable",
      "justification": "The SDK has no distributed infrastructure boundary."
    },
    "security": {
      "status": "required",
      "command": "python -m unittest discover -s tests -v && python -m bandit -r src -q -lll -iii && gitleaks git --redact",
      "evidence": ["tests", "src", ".github/workflows/ci.yml"]
    },
    "accessibility": {
      "status": "not_applicable",
      "justification": "The Python SDK does not provide a graphical user interface."
    },
    "documentation": {
      "status": "required",
      "command": "python -m compileall -q examples",
      "evidence": ["README.md", "docs", "examples"]
    },
    "governance": {
      "status": "required",
      "command": "python tools/bqa_verify.py --mode baseline",
      "evidence": ["docs"]
    },
    "schema": {
      "status": "required",
      "command": "python -m unittest discover -s tests -v",
      "evidence": ["src/bonfim/schemas", "tests"]
    },
    "api": {
      "status": "required",
      "command": "python -m unittest discover -s tests -v",
      "evidence": ["src/bonfim", "tests"]
    }
  },
  "staticChecks": {
    "typing": {
      "status": "required",
      "command": "python -m mypy -p bonfim",
      "evidence": ["src", ".github/workflows/ci.yml"]
    },
    "linting": {
      "status": "required",
      "command": "python -m ruff check src tests examples tools",
      "evidence": ["src", "tests", "examples", "tools", ".github/workflows/ci.yml"]
    },
    "formatting": {
      "status": "required",
      "command": "python tools/format_verify.py --output artifacts/format-evidence.json",
      "evidence": ["tools/format_verify.py", ".github/workflows/ci.yml"]
    },
    "secret-detection": {
      "status": "required",
      "command": "gitleaks git --redact",
      "evidence": [".github/workflows/ci.yml"]
    },
    "sast": {
      "status": "required",
      "command": "python -m bandit -r src -q -lll -iii",
      "evidence": ["src", ".github/workflows/ci.yml"]
    },
    "sbom": {
      "status": "required",
      "command": "bash tools/generate_sbom.sh artifacts/bonfim-sdk.cdx.json",
      "evidence": ["tools/generate_sbom.sh", "artifacts/bonfim-sdk.cdx.json", ".github/workflows/ci.yml"]
    },
    "license-verification": {
      "status": "required",
      "command": "python tools/license_verify.py --output artifacts/license-evidence.json",
      "evidence": ["LICENSE", "NOTICE", "pyproject.toml", "tools/license_verify.py", ".github/workflows/ci.yml"]
    }
  },
  "release": {
    "certification": "human-review-required",
    "humanReviewStatus": "approved",
    "approvalStatus": "Aprovado",
    "releaseDecision": "approved"
  }
}
